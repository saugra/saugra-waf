#!/bin/sh
set -e

ensure_dir() {
  path="$1"
  owner="$2"
  group="$3"
  mode="$4"

  install -d -o "$owner" -g "$group" -m "$mode" "$path"
}

copy_if_missing() {
  source="$1"
  target="$2"
  mode="$3"
  owner="$4"
  group="$5"

  if [ ! -f "$target" ]; then
    cp "$source" "$target"
    chown "$owner:$group" "$target"
    chmod "$mode" "$target"
  fi
}

if ! getent group saugra-waf >/dev/null; then
  addgroup --system saugra-waf
fi

if ! getent passwd saugra-waf >/dev/null; then
  adduser --system --ingroup saugra-waf --home /var/lib/saugra-waf --no-create-home saugra-waf
fi

ensure_dir /etc/saugra-waf root saugra-waf 0750
ensure_dir /etc/saugra-waf/rules root saugra-waf 0750
ensure_dir /etc/saugra-waf/standards root saugra-waf 0750
ensure_dir /etc/saugra-waf/intelligence root saugra-waf 0750
ensure_dir /etc/saugra-waf/ai root saugra-waf 0750
ensure_dir /etc/saugra-waf/ollama root saugra-waf 0750
ensure_dir /var/lib/saugra-waf saugra-waf saugra-waf 0750
ensure_dir /var/log/saugra-waf saugra-waf adm 0750

copy_if_missing /usr/share/saugra-waf/saugra-waf.production.example.yml /etc/saugra-waf/saugra-waf.yml 0640 root saugra-waf

for rule in /usr/share/saugra-waf/rules/*.yml; do
  [ -e "$rule" ] || continue
  copy_if_missing "$rule" "/etc/saugra-waf/rules/$(basename "$rule")" 0640 root saugra-waf
done

for standard in /usr/share/saugra-waf/standards/*.yml; do
  [ -e "$standard" ] || continue
  copy_if_missing "$standard" "/etc/saugra-waf/standards/$(basename "$standard")" 0640 root saugra-waf
done

for catalog in /usr/share/saugra-waf/intelligence/*.yml; do
  [ -e "$catalog" ] || continue
  copy_if_missing "$catalog" "/etc/saugra-waf/intelligence/$(basename "$catalog")" 0640 root saugra-waf
done

copy_if_missing /usr/share/saugra-waf/ollama/Modelfile /etc/saugra-waf/ollama/Modelfile 0640 root saugra-waf

for fixture in /usr/share/saugra-waf/ai/*.jsonl; do
  [ -e "$fixture" ] || continue
  copy_if_missing "$fixture" "/etc/saugra-waf/ai/$(basename "$fixture")" 0640 root saugra-waf
done

if command -v systemctl >/dev/null; then
  systemctl daemon-reload || true
fi

exit 0
