[Unit]
Description=Saugra Web Application Firewall
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=saugra
Group=saugra
ExecStart=/usr/local/bin/saugra run --config /etc/saugra/saugra.yml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/saugra

[Install]
WantedBy=multi-user.target
